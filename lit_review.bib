@article{frechetteDoesEstuaryPrey2026,
  title = {Does {{Estuary Prey Abundance}} and {{Diversity Buffer Salmo}} Salar ({{Atlantic Salmon}}) {{Smolts}} from {{Predation}} by {{Nannopterum}} Auritum ({{Double-Crested Cormorant}})?},
  author = {Frechette, Danielle and Carrier, Joanie and Leblanc, David and Carr, Jonathan and Bergeron, Normand and Vicaire, John Murvin and Gillis, Carole-Anne},
  year = 2026,
  month = jul,
